# DO NOT commit live tokens or customer records. Do not put these values in frontend builds.
PORT=8788
HOST=127.0.0.1
SMITH_OS_DATABASE=./data/store.json
# Generate >=32-char tokens: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Provide 1 owner and 1 project key per project. Edit as one-line JSON.
# Example shape only; dummy keys are not valid operational credentials:
# SMITH_OS_KEYS_JSON='[{"key":"GENERATE_RANDOM_64_CHARACTER_SECRET_KEY_HERE","role":"owner"},{"key":"GENERATE_DIFFERENT_SECRET_FOR_EACH_PROJECT","role":"project","projectId":"smith-academy"}]'
# For Docker only, listen on internal interface; front-facing TLS proxy mandatory.
# SMITH_OS_PUBLIC_LISTEN_ACKNOWLEDGED=true
